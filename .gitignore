# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite Database
*.db
*.sqlite3

# Uploads directory contents (preserve directory structure via .gitkeep)
static/uploads/documents/*
!static/uploads/documents/.gitkeep
static/uploads/profile_pics/*
!static/uploads/profile_pics/.gitkeep

# Environment variables
.env
.env.*

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE / Editor configuration
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
